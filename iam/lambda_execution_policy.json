{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogsPermission",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/RetailServerlessETLFunction:*"
    },
    {
      "Sid": "S3DataLakeReadRaw",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME",
        "arn:aws:s3:::YOUR_BUCKET_NAME/raw/*"
      ]
    },
    {
      "Sid": "S3DataLakeWriteOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/curated/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/warehouse/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/quarantine/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/reports/*"
      ]
    }
  ]
}

# Pipeline Environment Configuration (Phase 1 Local / Phase 2 AWS Ready)
PROJECT_NAME=serverless-etl-data-quality-pipeline
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Data Paths
RAW_DATA_PATH=data/raw/retail_transactions.csv
CLEAN_DATA_PATH=data/clean/retail_transactions_clean.csv
REPORTS_DIR=reports/

# AWS Staging Placeholders (To be configured in Phase 2)
# AWS_REGION=us-east-1
# S3_RAW_BUCKET=my-retail-raw-bucket
# S3_CLEAN_BUCKET=my-retail-clean-bucket

# Amazon RDS PostgreSQL Warehouse Configuration (Phase 3)
RDS_HOST=retail-dw-instance.c9xxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=retail_warehouse
RDS_USERNAME=dw_admin
RDS_PASSWORD=SecureMasterPassword123!
# Set USE_SQLITE_FALLBACK=true to test locally without RDS instance
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=data/warehouse.db
